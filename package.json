{
  "name": "agri-video-library",
  "version": "1.0.0",
  "description": "农技示范视频库：CSV 导入、按作物/季节筛选、过期标记、错误报告下载",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node src/seed.js",
    "test": "node --test test/",
    "test:unit": "node --test test/import.service.test.js test/csv.parse.test.js",
    "test:integration": "TEST_DB=1 node --test test/db.integration.test.js"
  },
  "dependencies": {
    "csv-parse": "^5.5.6",
    "express": "^4.19.2",
    "iconv-lite": "^0.6.3",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.0"
  }
}
